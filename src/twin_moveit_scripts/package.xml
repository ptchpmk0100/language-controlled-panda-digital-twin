<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>twin_moveit_scripts</name>
  <version>0.1.0</version>
  <description>Scripted motion primitives for the Panda, built on moveit_py.</description>
  <maintainer email="59853829+ptchpmk0100@users.noreply.github.com">Khoi Minh Pham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Supplies the SRDF, kinematics and controller seam this node plans with. -->
  <exec_depend>twin_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
