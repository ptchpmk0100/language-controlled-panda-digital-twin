<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>twin_description</name>
  <version>0.0.0</version>
  <description>Robot description files for the digital twin. Holds URDF models whose links carry the inertial properties Gazebo requires for physics simulation.</description>
  <maintainer email="59853829+ptchpmk0100@users.noreply.github.com">Khoi Minh Pham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Spawning a description into Gazebo uses the ros_gz_sim create tool. -->
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
